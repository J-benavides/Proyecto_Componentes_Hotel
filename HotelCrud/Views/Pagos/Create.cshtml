@model HotelCrud.Models.Pago

@{
    ViewData["Title"] = "Crear Pago";
}

<h1 class="text-3xl font-bold mb-6 text-gray-800">Crear Nuevo Pago</h1>

<div class="bg-white shadow-md rounded-lg p-6">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>
        <div class="mb-4">
            <label asp-for="IdReservacion" class="block text-sm font-medium text-gray-700"></label>
            <select asp-for="IdReservacion" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2" asp-items="ViewBag.IdReservacion"></select>
            <span asp-validation-for="IdReservacion" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="mb-4">
            <label asp-for="MontoTotal" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="MontoTotal" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2" />
            <span asp-validation-for="MontoTotal" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="mb-4">
            <label asp-for="FechaPago" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="FechaPago" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2" />
            <span asp-validation-for="FechaPago" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="mb-4">
            <label asp-for="MetodoPago" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="MetodoPago" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2" />
            <span asp-validation-for="MetodoPago" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="flex items-center justify-between mt-6">
            <button type="submit" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded-lg transition duration-300">Crear</button>
            <a asp-action="Index" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded-lg transition duration-300">Volver a la Lista</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}