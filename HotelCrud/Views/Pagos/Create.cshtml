@model HotelCrud.Models.Pagos

@{
    ViewData["Title"] = "Crear Pago";
}

<div class="container my-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

        <div class="form-group mb-3">
            <label asp-for="IdReservacion" class="form-label">Reservación</label>
            <select asp-for="IdReservacion" class="form-select" asp-items="ViewBag.IdReservacion">
                <option value="">-- Seleccione una reservación --</option>
            </select>
            <span asp-validation-for="IdReservacion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="MontoTotal" class="form-label"></label>
            <input asp-for="MontoTotal" class="form-control" />
            <span asp-validation-for="MontoTotal" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="FechaPago" class="form-label"></label>
            <input asp-for="FechaPago" class="form-control" type="date" />
            <span asp-validation-for="FechaPago" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="MetodoPago" class="form-label"></label>
            <input asp-for="MetodoPago" class="form-control" />
            <span asp-validation-for="MetodoPago" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            <i class="uil uil-check me-1"></i> Guardar
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="uil uil-times-circle me-1"></i> Cancelar
        </a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}