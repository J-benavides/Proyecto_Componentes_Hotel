@model HotelCrud.Models.Pagos

@{
    ViewData["Title"] = "Editar Pago";
}

<div class="container my-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-3">
            <label asp-for="IdReservacion" class="form-label"></label>
            <input asp-for="IdReservacion" class="form-control" />
            <span asp-validation-for="IdReservacion" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="MontoTotal" class="form-label"></label>
            <input asp-for="MontoTotal" class="form-control" />
            <span asp-validation-for="MontoTotal" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="FechaPago" class="form-label"></label>
            <input asp-for="FechaPago" class="form-control" type="date" />
            <span asp-validation-for="FechaPago" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="MetodoPago" class="form-label"></label>
            <input asp-for="MetodoPago" class="form-control" />
            <span asp-validation-for="MetodoPago" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
