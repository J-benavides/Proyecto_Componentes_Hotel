@model HotelCrud.Models.Pagos

@{
    ViewData["Title"] = "Detalles del Pago";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">ID Pago</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">ID Reserva</dt>
            <dd class="col-sm-9">@Model.IdReservacion</dd>

            <dt class="col-sm-3">Cliente</dt>
            <dd class="col-sm-9">@Model.IdReservacionNavigation.IdPersonaNavigation?.Nombre</dd>

            <dt class="col-sm-3">Habitación</dt>
            <dd class="col-sm-9">@Model.IdReservacionNavigation.IdHabitacionNavigation?.Numero</dd>

            <dt class="col-sm-3">Monto Total</dt>
            <dd class="col-sm-9">@Model.MontoTotal?.ToString("C")</dd>

            <dt class="col-sm-3">Fecha Pago</dt>
            <dd class="col-sm-9">@Model.FechaPago?.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Método de Pago</dt>
            <dd class="col-sm-9">@Model.MetodoPago</dd>

            @if (!string.IsNullOrEmpty(Model.NumeroTarjeta))
            {
                var numeroLimpio = Model.NumeroTarjeta.Replace(" ", "");
                var longitud = numeroLimpio.Length;
                var ultimos4 = longitud > 4 ? numeroLimpio.Substring(longitud - 4) : numeroLimpio;
                var enmascarado = new string('*', Math.Max(0, longitud - 4)) + ultimos4;

                <dt class="col-sm-3">Número de Tarjeta</dt>
                <dd class="col-sm-9">@enmascarado</dd>

                <dt class="col-sm-3">CVV</dt>
                <dd class="col-sm-9">***</dd>

                <dt class="col-sm-3">Nombre en la Tarjeta</dt>
                <dd class="col-sm-9">@Model.NombreTarjeta</dd>

                <dt class="col-sm-3">Fecha de Expiración</dt>
                <dd class="col-sm-9">@Model.FechaExpiracion</dd>
            }
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
