@model HotelCrud.Models.Pagos

@{
    ViewData["Title"] = "Eliminar Pago";
}

<div class="container my-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <h4>¿Está seguro que desea eliminar este pago?</h4>

    <div class="mb-3">
        <label>Monto Total:</label>
        <input class="form-control" value="@Model.MontoTotal.ToString("C")" readonly />
    </div>

    <div class="mb-3">
        <label>Fecha de Pago:</label>
        <input class="form-control" value="@Model.FechaPago?.ToString("yyyy-MM-dd")" readonly />
    </div>

    <div class="mb-3">
        <label>Método de Pago:</label>
        <input class="form-control" value="@Model.MetodoPago" readonly />
    </div>

    <div class="mb-3">
        <label>Persona:</label>
        <input class="form-control" value="@Model.IdReservacion" readonly />
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="uil uil-trash-alt me-1"></i> Eliminar
        </button>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="uil uil-times-circle me-1"></i> Cancelar
        </a>
    </form>
</div>