@model HotelCrud.Models.Pago

@{
    ViewData["Title"] = "Eliminar Pago";
}

<h1 class="text-3xl font-bold mb-6 text-gray-800">Eliminar Pago</h1>

<h3 class="text-xl font-semibold text-gray-700 mb-4">¿Estás seguro de que quieres eliminar este pago?</h3>

<div class="bg-white shadow-md rounded-lg p-6 mb-6">
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-2">
        <dt class="text-gray-500 font-semibold">
            @Html.DisplayNameFor(model => model.MontoTotal)
        </dt>
        <dd class="text-gray-900">
            @Html.DisplayFor(model => model.MontoTotal)
        </dd>
        <dt class="text-gray-500 font-semibold">
            @Html.DisplayNameFor(model => model.FechaPago)
        </dt>
        <dd class="text-gray-900">
            @Html.DisplayFor(model => model.FechaPago)
        </dd>
        <dt class="text-gray-500 font-semibold">
            @Html.DisplayNameFor(model => model.MetodoPago)
        </dt>
        <dd class="text-gray-900">
            @Html.DisplayFor(model => model.MetodoPago)
        </dd>
        <dt class="text-gray-500 font-semibold">
            Reservación ID
        </dt>
        <dd class="text-gray-900">
            @Html.DisplayFor(model => model.IdReservacion)
        </dd>
    </dl>
</div>

<form asp-action="Delete" class="flex items-center">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg mr-2 transition duration-300">Eliminar</button>
    <a asp-action="Index" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded-lg transition duration-300">Cancelar</a>
</form>