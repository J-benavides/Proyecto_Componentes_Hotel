@model IEnumerable<HotelCrud.Models.Pagos>
@{
    ViewData["Title"] = "Pagos";
    var rol = Context.Session.GetString("Rol") ?? "";
    decimal totalIngresos = ViewBag.TotalIngresos != null ? (decimal)ViewBag.TotalIngresos : 0m;
}

<h2>@ViewData["Title"]</h2>

@if (rol == "Admin")
{
    <div class="alert alert-info">
        <strong>Total Ingresos:</strong> @totalIngresos.ToString("C")
    </div>
}

@if (rol == "Cliente")
{
    <a asp-action="Create" class="btn btn-primary mb-3">Realizar Pago</a>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID Reserva</th>
            <th>Cliente</th>
            <th>Habitación</th>
            <th>Monto Total</th>
            <th>Fecha Pago</th>
            <th>Método de Pago</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pago in Model)
        {
            <tr>
                <td>@pago.IdReservacion</td>
                <td>@pago.IdReservacionNavigation.IdPersonaNavigation?.Nombre</td>
                <td>@pago.IdReservacionNavigation.IdHabitacionNavigation?.Numero</td>
                <td>@(pago.MontoTotal?.ToString("C") ?? "-")</td>
                <td>@pago.FechaPago?.ToString("yyyy-MM-dd")</td>
                <td>@pago.MetodoPago</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pago.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@pago.Id" class="btn btn-danger btn-sm">Cancelar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
