@model HotelCrud.Models.Reserva

@{
    ViewData["Title"] = "Detalles de Reserva";
}

<h2>@ViewData["Title"]</h2>

<div class="mb-3">
    <label>Persona:</label>
    <input class="form-control" value="@Model.IdPersonaNavigation?.Nombre @Model.IdPersonaNavigation?.Apellidos" readonly />
</div>

<div class="mb-3">
    <label>Habitación:</label>
    <input class="form-control" value="@Model.IdHabitacionNavigation?.Numero" readonly />
</div>

<div class="mb-3">
    <label>Fecha Entrada:</label>
    <input class="form-control" value="@Model.FechaEntrada?.ToString("yyyy-MM-dd")" readonly />
</div>

<div class="mb-3">
    <label>Fecha Salida:</label>
    <input class="form-control" value="@Model.FechaSalida?.ToString("yyyy-MM-dd")" readonly />
</div>

<div class="mb-3">
    <label>Estado Habitación:</label>
    <input class="form-control" value="@Model.IdHabitacionNavigation?.Estado" readonly />
</div>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
