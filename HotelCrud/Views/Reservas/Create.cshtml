@model HotelCrud.Models.Reserva

@{
    ViewData["Title"] = "Crear Reserva";
}

<h2>Crear Reserva</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="IdPersona" class="form-label">Persona</label>
        <select asp-for="IdPersona" class="form-select" asp-items="ViewBag.IdPersona"></select>
        <span asp-validation-for="IdPersona" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdHabitacion" class="form-label">Habitación</label>
        <select asp-for="IdHabitacion" class="form-select" asp-items="ViewBag.IdHabitacion"></select>
        <span asp-validation-for="IdHabitacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaEntrada" class="form-label">Fecha Entrada</label>
        <input asp-for="FechaEntrada" class="form-control" type="date" />
        <span asp-validation-for="FechaEntrada" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaSalida" class="form-label">Fecha Salida</label>
        <input asp-for="FechaSalida" class="form-control" type="date" />
        <span asp-validation-for="FechaSalida" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Crear</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
