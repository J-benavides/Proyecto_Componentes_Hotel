@model HotelCrud.Models.Reserva

@{
    ViewData["Title"] = "Crear Reserva";
    var rol = Context.Session.GetString("Rol") ?? "";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form asp-action="Create" method="post" novalidate>
    @if (rol == "Admin")
    {
        <div class="form-group mb-3">
            <label asp-for="IdPersona" class="form-label">Persona</label>
            <select asp-for="IdPersona" class="form-select" asp-items="@(ViewData["IdPersona"] as SelectList)">
                <option value="">-- Seleccione una persona --</option>
            </select>
            <span asp-validation-for="IdPersona" class="text-danger"></span>
        </div>
    }
    else
    {
        <!-- El cliente solo puede reservar para sí mismo -->
        <input asp-for="IdPersona" type="hidden" value="@Context.Session.GetInt32("IdPersona")" />
    }

    <div class="form-group mb-3">
        <label asp-for="IdHabitacion" class="form-label">Habitación</label>
        <select asp-for="IdHabitacion" class="form-select" asp-items="@(ViewData["IdHabitacion"] as SelectList)">
            <option value="">-- Seleccione una habitación --</option>
        </select>
        <span asp-validation-for="IdHabitacion" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaEntrada" class="form-label"></label>
        <input asp-for="FechaEntrada" class="form-control" type="date" />
        <span asp-validation-for="FechaEntrada" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FechaSalida" class="form-label"></label>
        <input asp-for="FechaSalida" class="form-control" type="date" />
        <span asp-validation-for="FechaSalida" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
