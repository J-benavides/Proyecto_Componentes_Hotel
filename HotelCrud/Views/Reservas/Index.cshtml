@model IEnumerable<HotelCrud.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h2>Reservas</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Nueva Reserva</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Persona</th>
            <th>Habitación</th>
            <th>Fecha Entrada</th>
            <th>Fecha Salida</th>
            <th>Estado Habitación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdPersonaNavigation?.Nombre @item.IdPersonaNavigation?.Apellidos</td>
                <td>@item.IdHabitacionNavigation?.Numero</td>
                <td>@item.FechaEntrada?.ToString("yyyy-MM-dd")</td>
                <td>@item.FechaSalida?.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (item.IdHabitacionNavigation != null)
                    {
                        <span class="badge @(item.IdHabitacionNavigation.Estado == "Ocupada" ? "bg-danger" : "bg-success")">
                            @item.IdHabitacionNavigation.Estado
                        </span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
