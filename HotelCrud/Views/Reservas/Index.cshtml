@model IEnumerable<HotelCrud.Models.Reserva>
@{
    ViewData["Title"] = "Listado de Reservas";
}

<h1 class="mb-4">Listado de Reservas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="fas fa-plus"></i> Nueva Reserva
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cliente</th>
            <th>Habitación</th>
            <th>Fecha Entrada</th>
            <th>Fecha Salida</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.IdPersonaNavigation.Nombre)</td>
                <td>Habitación @Html.DisplayFor(modelItem => item.IdHabitacionNavigation.Numero)</td>
                <td>@item.FechaEntrada?.ToString("dd/MM/yyyy")</td>
                <td>@item.FechaSalida?.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Editar">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Detalles">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                        <i class="fas fa-trash-alt"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>