@model IEnumerable<HotelCrud.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
    var rol = Context.Session.GetString("Rol") ?? "";
    var idPersona = Context.Session.GetInt32("IdPersona") ?? 0;
}

<div class="container my-4">
    <h2 class="mb-4">@((rol == "Admin") ? "Reservas" : "Mis Reservas")</h2>

    <div class="mb-3">
        @if (rol == "Cliente" || rol == "Admin")
        {
            <a class="btn btn-success" asp-action="Create">
                <i class="uil uil-plus me-1"></i> Nueva Reserva
            </a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    @if (rol == "Admin")
                    {
                        <th>Persona</th>
                    }
                    <th>Habitación</th>
                    <th>Fecha Entrada</th>
                    <th>Fecha Salida</th>
                    <th>Estado Habitación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (rol == "Admin")
                        {
                            <td>@item.IdPersonaNavigation?.Nombre @item.IdPersonaNavigation?.Apellidos</td>
                        }
                        <td>@item.IdHabitacionNavigation?.Numero</td>
                        <td>@item.FechaEntrada?.ToString("yyyy-MM-dd")</td>
                        <td>@item.FechaSalida?.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.IdHabitacionNavigation != null)
                            {
                                <span class="badge @(item.IdHabitacionNavigation.Estado == "Ocupada" ? "bg-danger" : "bg-success")">
                                    @item.IdHabitacionNavigation.Estado
                                </span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Detalles">
                                <i class="uil uil-eye"></i>
                            </a>

                            @if (rol == "Admin" || item.IdPersona == idPersona)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1" title="Editar">
                                    <i class="uil uil-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                    <i class="uil uil-trash-alt"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
