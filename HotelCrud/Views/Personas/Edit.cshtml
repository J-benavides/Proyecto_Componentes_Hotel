@model HotelCrud.Models.PersonaEditViewModel

@{
    ViewData["Title"] = "Editar Persona";
    var rol = Context.Session.GetString("Rol") ?? "";
    var idPersonaSesion = Context.Session.GetInt32("IdPersona") ?? 0;
    bool esAdmin = rol == "Admin";
    bool esCliente = rol == "Cliente";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-8 col-sm-10">
            <div class="card shadow-sm rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Editar Persona</h3>
                </div>
                <div class="card-body">

                    @* Validar que cliente no pueda editar otro perfil *@
                    @if (esCliente && Model.Id != idPersonaSesion)
                    {
                        <div class="alert alert-danger">
                            No tienes permiso para editar este perfil.
                        </div>
                    }
                    else
                    {
                        <form asp-action="Edit" method="post" novalidate>
                            <input type="hidden" asp-for="Id" />

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label asp-for="Nombre" class="font-weight-bold"></label>
                                    <input asp-for="Nombre" class="form-control" />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="Apellidos" class="font-weight-bold"></label>
                                    <input asp-for="Apellidos" class="form-control" />
                                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Correo" class="font-weight-bold"></label>
                                <input asp-for="Correo" class="form-control" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Telefono" class="font-weight-bold"></label>
                                <input asp-for="Telefono" class="form-control" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>

                            <hr />

                            <h5 class="mb-3 text-primary">Cambiar contraseña</h5>

                            <div class="form-group">
                                <label asp-for="ContrasenaActual" class="font-weight-bold"></label>
                                <input asp-for="ContrasenaActual" class="form-control" type="password" autocomplete="current-password" />
                                <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label asp-for="NuevaContrasena" class="font-weight-bold"></label>
                                    <input asp-for="NuevaContrasena" class="form-control" type="password" autocomplete="new-password" />
                                    <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <label asp-for="ConfirmarNuevaContrasena" class="font-weight-bold"></label>
                                    <input asp-for="ConfirmarNuevaContrasena" class="form-control" type="password" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmarNuevaContrasena" class="text-danger small"></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block font-weight-bold mt-4">
                                Guardar cambios
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
