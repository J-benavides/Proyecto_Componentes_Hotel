@model HotelCrud.Models.Persona

@{
    ViewData["Title"] = "Eliminar Persona";
}

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4>¿Estás seguro de que deseas eliminar esta persona?</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Nombre:</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Apellidos:</dt>
                <dd class="col-sm-9">@Model.Apellidos</dd>

                <dt class="col-sm-3">Correo:</dt>
                <dd class="col-sm-9">@Model.Correo</dd>

                <dt class="col-sm-3">Teléfono:</dt>
                <dd class="col-sm-9">@Model.Telefono</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        @if (TempData["MensajeExito"] != null)
        {
                    <text>
                        Swal.fire({
                            icon: 'success',
                            title: '¡Éxito!',
                            text: '@TempData["MensajeExito"]'
                        });
                    </text>
        }

        @if (TempData["MensajeError"] != null)
        {
                    <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@TempData["MensajeError"]'
                        });
                    </text>
        }
    </script>
}