@model HotelCrud.Models.Habitacione
@{
    ViewData["Title"] = "Detalles de la Habitación";
}

<h2>Detalles de la Habitación</h2>

<div class="mb-3">
    <strong>Número:</strong> @Model.Numero
</div>
<div class="mb-3">
    <strong>Tipo:</strong> @Model.Tipo
</div>
<div class="mb-3">
    <strong>Precio:</strong> ₡@Model.Precio
</div>
<div class="mb-3">
    <strong>Estado:</strong> @Model.Estado
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
