@model HotelCrud.Models.Habitacione
@{
    ViewData["Title"] = "Eliminar Habitación";
}

<h2>Eliminar Habitación</h2>

<h4>¿Estás seguro de que deseas eliminar esta habitación?</h4>

<div class="mb-3">
    <strong>Número:</strong> @Model.Numero
</div>
<div class="mb-3">
    <strong>Tipo:</strong> @Model.Tipo
</div>
<div class="mb-3">
    <strong>Precio:</strong> ₡@Model.Precio
</div>
<div class="mb-3">
    <strong>Estado:</strong> @Model.Estado
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
