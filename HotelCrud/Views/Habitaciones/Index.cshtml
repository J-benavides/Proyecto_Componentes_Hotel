@model IEnumerable<HotelCrud.Models.Habitacione>
@{
    ViewData["Title"] = "Lista de Habitaciones";
}

<h2 class="mb-4">Lista de Habitaciones</h2>

<a asp-action="Create" class="btn btn-success mb-3">Registrar Nueva Habitación</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Número</th>
            <th>Tipo</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Numero</td>
                <td>@item.Tipo</td>
                <td>₡@item.Precio</td>
                <td>@item.Estado</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
