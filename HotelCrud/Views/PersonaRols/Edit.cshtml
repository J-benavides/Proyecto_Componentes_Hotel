@model HotelCrud.Models.PersonaRol

@{
    ViewData["Title"] = "Editar Asignación Persona-Rol";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-8">
            <div class="card shadow-sm rounded-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-3">
                            <label asp-for="IdPersona" class="font-weight-bold">Persona</label>
                            <select asp-for="IdPersona" class="form-select" asp-items="ViewBag.IdPersona">
                                <option value="">-- Seleccione una persona --</option>
                            </select>
                            <span asp-validation-for="IdPersona" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="IdRol" class="font-weight-bold">Rol</label>
                            <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol">
                                <option value="">-- Seleccione un rol --</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block font-weight-bold">
                            Actualizar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-block mt-2">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
