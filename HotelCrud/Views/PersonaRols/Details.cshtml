@model HotelCrud.Models.PersonaRol

@{
    ViewData["Title"] = "Detalles de Asignación";
}

<h2>@ViewData["Title"]</h2>

<div class="card mt-3" style="max-width: 400px;">
    <div class="card-body">
        <h5 class="card-title">Persona</h5>
        <p class="card-text">@Model.IdPersonaNavigation.Nombre @Model.IdPersonaNavigation.Apellidos</p>

        <h5 class="card-title">Rol</h5>
        <p class="card-text">@Model.IdRolNavigation.Nombre</p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
    </div>
</div>
