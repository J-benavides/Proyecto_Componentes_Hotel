@model HotelCrud.Models.PersonaRol

@{
    ViewData["Title"] = "Crear Asignación Persona-Rol";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="form-group mb-3">
        <label for="IdPersona">Persona</label>
        <select asp-for="IdPersona" class="form-select" asp-items="ViewBag.IdPersona">
            <option value="">-- Seleccione una persona --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label for="IdRol">Rol</label>
        <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol">
            <option value="">-- Seleccione un rol --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>
