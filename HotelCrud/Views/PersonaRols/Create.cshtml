@model HotelCrud.Models.PersonaRol
@{
    ViewData["Title"] = "Asignar Rol a Persona";
}

<h1>Asignar Rol a Persona</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <h4>Errores de validación:</h4>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="IdPersona" class="control-label">Persona</label>
                <select asp-for="IdPersona" class="form-control" asp-items="ViewBag.IdPersona" required>
                    <option value="">-- Seleccione una persona --</option>
                </select>
                <span asp-validation-for="IdPersona" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdRol" class="control-label">Rol</label>
                <select asp-for="IdRol" class="form-control" asp-items="ViewBag.IdRol" required>
                    <option value="">-- Seleccione un rol --</option>
                </select>
                <span asp-validation-for="IdRol" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Asignar Rol
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver al Listado
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}