@model HotelCrud.Models.PersonaRol

@{
    ViewData["Title"] = "Eliminar Asignación";
}

<h2 class="text-danger">@ViewData["Title"]</h2>

<div class="alert alert-warning mt-3" role="alert">
    ¿Está seguro que desea eliminar la asignación entre la persona
    <strong>@Model.IdPersonaNavigation.Nombre @Model.IdPersonaNavigation.Apellidos</strong>
    y el rol
    <strong>@Model.IdRolNavigation.Nombre</strong>?
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>
