@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v2.1.9/css/unicons.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body class="bg-light">
    <div class="section vh-100 d-flex justify-content-center align-items-center">
        <div class="card shadow-sm p-4" style="max-width: 400px; width: 100%; border-radius: 10px;">
            <h4 class="mb-4 text-center font-weight-bold text-primary">Inicia sesión</h4>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
            }

            <form asp-controller="Cuenta" asp-action="Login" method="post" novalidate>
                <div class="form-group position-relative">
                    <input type="email" name="correo" class="form-control pl-5" placeholder="Correo electrónico" required />
                    <i class="input-icon uil uil-at text-primary"></i>
                </div>
                <div class="form-group position-relative mt-3">
                    <input type="password" name="contrasena" class="form-control pl-5" placeholder="Contraseña" required />
                    <i class="input-icon uil uil-lock-alt text-primary"></i>
                </div>
                <button type="submit" class="btn btn-primary btn-block mt-4 font-weight-bold">Ingresar</button>
            </form>

            <p class="mt-4 text-center">
                ¿No tienes cuenta? <a asp-controller="Cuenta" asp-action="Registro" class="text-primary font-weight-bold">Regístrate aquí</a>
            </p>
        </div>
    </div>
</body>
</html>
